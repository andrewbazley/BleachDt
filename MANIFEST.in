# Documentation and metadata
include README.md
include LICENSE
include requirements.txt
include pyproject.toml
include setup.py

# Package source
recursive-include bleachdt *.py

# Exclude compiled / cache / OS cruft
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.nbc
global-exclude *.nbi
global-exclude *.so
global-exclude .DS_Store
global-exclude .git*
